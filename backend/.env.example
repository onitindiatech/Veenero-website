# ─────────────────────────────────────────────────────────────────────────────
# Veenero CMS API — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_VERSION=v1

# ── Database (MongoDB) ────────────────────────────────────────────────────────
# Local:   mongodb://localhost:27017/veenero_cms
# Atlas:   mongodb+srv://USER:PASSWORD@cluster.mongodb.net/veenero_cms?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/veenero_cms

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_64_CHARS
JWT_EXPIRES_IN=7d

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=debug

# ── CORS & Frontend ──────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Seed Credentials ─────────────────────────────────────────────────────────
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@veenero.com
ADMIN_PASSWORD=admin123

# ── Cloudinary (Backend only) ─────────────────────────────────────────────────
# SECURITY RULES:
#   - NEVER add these to frontend code or VITE_* variables
#   - CLOUDINARY_API_SECRET must NEVER appear in API responses, logs, or git
#   - Only CLOUDINARY_CLOUD_NAME may eventually reach the frontend (for public delivery URLs)
#
# Get values from: https://console.cloudinary.com/ -> Settings -> API Keys
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_NEVER_COMMIT_REAL_VALUE
