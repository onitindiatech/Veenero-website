  "description": "Veenero CMS — Backend API (Express + TypeScript + MongoDB + Mongoose)",
  "private": true,
  "main": "dist/app.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child src/app.ts",
    "build": "tsc",
