# ─────────────────────────────────────────────────────────────────────────────
# Veenero Frontend — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# For LOCAL development:
#   Copy this file to .env.local and set your values.
#   .env.local is gitignored and never committed.
#
# For PRODUCTION (Vercel):
#   Set these in the Vercel project → Settings → Environment Variables panel.
#   NEVER hardcode production values into committed files.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ──────────────────────────────────────────────────────────────────

# Backend API base URL — no trailing slash.
# Local dev:   http://localhost:4000
# Production:  https://veenero-website.onrender.com
VITE_API_URL=http://localhost:4000

# ── OPTIONAL ──────────────────────────────────────────────────────────────────

# Public site URL — used for canonical links and structured data.
# Local dev:   http://localhost:8080
# Production:  https://veenero.com  (or your Vercel deployment URL)
VITE_SITE_URL=http://localhost:8080
